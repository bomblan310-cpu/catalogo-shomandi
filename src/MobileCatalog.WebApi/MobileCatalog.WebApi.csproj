<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>MobileCatalogAPI-local-admin</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MobileCatalog.Application\MobileCatalog.Application.csproj" />
    <ProjectReference Include="..\MobileCatalog.Domain\MobileCatalog.Domain.csproj" />
    <ProjectReference Include="..\MobileCatalog.Infrastructure\MobileCatalog.Infrastructure.csproj" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\appsettings.Development.json')" />
  </ItemGroup>
</Project>
